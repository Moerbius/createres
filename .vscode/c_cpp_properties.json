{
  "configurations": [
    {
      "name": "Linux",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/snappy",
        "/usr/include"
      ],
      "defines": [
        "HAVE_CONFIG_H"
      ],
      "compilerPath": "/usr/bin/g++",
      "cStandard": "c99",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x64"
    },
    {
      "name": "Windows (MSYS64)",
      "includePath": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/snappy",
        "C:/msys64/usr/include",
        "C:/msys64/mingw64/include"
      ],
      "defines": [
        "HAVE_CONFIG_H",
        "WIN32_CONFIG",
        "_WIN32",
        "_WIN64"
      ],
      "compilerPath": "C:/msys64/mingw64/bin/g++.exe",
      "cStandard": "c99",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
