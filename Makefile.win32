# Makefile for Windows builds of createres
# Usage: make -f Makefile.win32

.PHONY: all clean help

CXX ?= g++
CXXFLAGS ?= -std=c++11 -Wall -Wextra -pedantic -DHAVE_CONFIG_H -DWIN32_CONFIG

SRC_DIR := src
BUILD_DIR := build
OBJ_DIR := $(BUILD_DIR)/obj
TARGET := $(BUILD_DIR)/createres.exe

SOURCES := \
	$(SRC_DIR)/main.cpp \
	$(SRC_DIR)/Resource.cpp \
	$(SRC_DIR)/snappy/snappy.cc \
	$(SRC_DIR)/snappy/snappy-sinksource.cc \
	$(SRC_DIR)/snappy/snappy-stubs-internal.cc

OBJECTS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(filter %.cpp,$(SOURCES)))
OBJECTS += $(patsubst $(SRC_DIR)/%.cc,$(OBJ_DIR)/%.o,$(filter %.cc,$(SOURCES)))

CPPFLAGS ?= -I$(SRC_DIR)/snappy

all: $(TARGET)

$(TARGET): $(OBJECTS) | $(BUILD_DIR)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(OBJECTS) -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cc | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(OBJ_DIR): | $(BUILD_DIR)
	mkdir -p $(OBJ_DIR)

clean:
	rm -rf $(OBJ_DIR) $(TARGET)

.PHONY: help
help:
	@echo "createres Windows Makefile"
	@echo ""
	@echo "Usage:"
	@echo "  make -f Makefile.win32          Build for Windows"
	@echo "  make -f Makefile.win32 clean    Clean build artifacts"
	@echo ""
	@echo "Variables:"
	@echo "  CXX                 C++ compiler (default: g++ or cl.exe for MSVC)"
	@echo "  CXXFLAGS            Compiler flags"
	@echo ""
	@echo "Notes:"
	@echo "  - For MinGW: use the default CXX (g++)"
	@echo "  - For MSVC: override CXX with cl or use Visual Studio build system"
